From: Mat Martineau <mathew.j.martineau@linux.intel.com>
Subject: [PATCH] hwdb: Fall back to other known paths for hwdb.bin
Date: Mon, 01 Aug 2016 12:11:18 -0700
Message-ID: <20160801191118.19330-1-mathew.j.martineau@linux.intel.com>
List-Id: <ell.lists.01.org>
To: ell@lists.01.org

--===============7022975207282072452==
Content-Type: text/plain; charset="utf-8"
MIME-Version: 1.0
Content-Transfer-Encoding: quoted-printable

l_hwdb_new_default() assumed one standard path for hwdb.bin, but it can
vary depending on distro and whether the database is immutable or
regenerated by the system.
---
 ell/hwdb.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/ell/hwdb.c b/ell/hwdb.c
index 0a26299..caa8eb3 100644
--- a/ell/hwdb.c
+++ b/ell/hwdb.c
@@ -161,7 +161,16 @@ failed:
 =

 LIB_EXPORT struct l_hwdb *l_hwdb_new_default(void)
 {
-	return l_hwdb_new("/etc/udev/hwdb.bin");
+	struct l_hwdb *db =3D NULL;
+	size_t i;
+	const char * const paths[] =3D {"/etc/udev/hwdb.bin",
+					"/usr/lib/udev/hwdb.bin",
+					"/lib/udev/hwdb.bin"};
+
+	for (i =3D 0; !db && i < L_ARRAY_SIZE(paths); i++)
+		db =3D l_hwdb_new(paths[i]);
+
+	return db;
 }
 =

 LIB_EXPORT struct l_hwdb *l_hwdb_ref(struct l_hwdb *hwdb)
-- =

2.9.2


