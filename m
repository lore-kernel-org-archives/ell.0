 static void tls_handle_dhe_server_key_xchg(struct l_tls *tls,
 						const uint8_t *buf, size_t len)
 {
@@ -1030,13 +1129,78 @@ static bool tls_send_dhe_client_key_xchg(struct l_t=
ls *tls)
 	return true;
 }
