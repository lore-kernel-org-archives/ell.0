 struct tls_dhe_params {
 	/*
 	 * We need both the raw contents here for tls_write_server_dh_params
@@ -875,6 +903,77 @@ static bool tls_get_server_dh_params_hash(struct l_tls=
 *tls, uint8_t tls_id,
 	return true;
 }
